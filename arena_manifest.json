{
  "arena_version": "0.1",
  "agent_name": "File Janitor",
  "domain": "File Janitor",
  "description": "A bounded single-agent service that analyzes and organizes files inside a synthetic in-memory sandbox: list, inspect, find duplicates and move files, with clarification, blocking and approval stops. It never touches a real filesystem.",
  "endpoint": "/arena/run",
  "health_endpoint": "/health",
  "implementation": "file_janitor",
  "fault_types": [
    "none",
    "tool_timeout",
    "malformed_tool_output",
    "invalid_agent_decision"
  ],
  "limits": {
    "max_steps": 6,
    "max_tool_retries": 2,
    "run_timeout_seconds": 40,
    "max_response_bytes": 50000,
    "max_output_tokens": 512
  },
  "tools": [
    "list_files",
    "inspect_file",
    "find_duplicates",
    "move_file"
  ],
  "control_actions": [
    "clarify",
    "finish",
    "blocked",
    "approval_required"
  ],
  "autonomy_boundary": {
    "sandbox_only": true,
    "real_filesystem_access": false,
    "permanent_delete": "not available; requests are blocked",
    "external_actions": "not available; requests are blocked"
  },
  "default_model": "gemini-3.5-flash-lite",
  "available_models": [
    "gemini-3.5-flash-lite",
    "gemini-3.1-flash-lite"
  ]
}
